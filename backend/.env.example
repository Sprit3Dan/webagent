# FastAPI backend
APP_NAME=webagent-backend
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=nemotron-30b
OPENAI_BASE_URL=http://inference.sprit3dan-labs.net/nemotron-30b/v1/

# Auth / multitenancy
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
REQUIRE_AUTH=false

# Agent behavior
MAX_CONTEXT_MESSAGES=500
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SECONDS=60
COMPACTION_TRIGGER_TOTAL_TOKENS=64000
COMPACTION_TARGET_TOTAL_TOKENS=24000