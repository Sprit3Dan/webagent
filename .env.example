# Shared environment template for webagent (frontend + backend)
# Copy to `.env` at repo root and customize values.

# ---------- Frontend ----------
# Vite dev proxy target (used by frontend/vite.config.js)
VITE_BACKEND_URL=http://localhost:8000

# ---------- Backend: App ----------
APP_NAME=webagent-backend
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:5173

# ---------- Backend: LLM ----------
OPENAI_API_KEY=
OPENAI_MODEL=nemotron-30b
OPENAI_BASE_URL=

# ---------- Backend: Auth ----------
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
REQUIRE_AUTH=false

# ---------- Backend: Web Push (optional) ----------
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# ---------- Backend: Agent behavior ----------
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SECONDS=60
COMPACTION_TRIGGER_TOTAL_TOKENS=64000
COMPACTION_TARGET_TOTAL_TOKENS=24000